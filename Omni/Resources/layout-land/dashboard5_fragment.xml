<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/activity_borders">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/activity_borders">

        <!-- bluetooth and upload indicators -->

        <ImageView
            android:id="@+id/bluetoothindicatorimageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/uploadindicatorimageview"
            android:contentDescription="@string/dashboard_bluetooth_status"
            android:src="@drawable/round_bluetooth_connected_green_20dp"
         />
        <ImageView
            android:id="@+id/uploadindicatorimageview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/dashboard_horizontal_margin"
            android:contentDescription="@string/dashboard_upload_status"
            android:src="@drawable/round_cloud_upload_red_20dp"
         />
      
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/uploadindicatorimageview"
            android:orientation="horizontal">

            <!--

            <TableLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="@dimen/dashboard_horizontal_margin"
                android:stretchColumns="*">

                <include layout="@layout/dashboard3_1"/>
            
            </TableLayout>

            <View
                android:layout_width="@dimen/dashboard_line_thickness"
                android:layout_height="match_parent"
                android:background="@android:color/darker_gray"/>

            -->

            <TableLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/dashboard_horizontal_margin"
                android:stretchColumns="*">

                <!--

                <include layout="@layout/dashboard3_2"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dashboard_line_thickness"
                    android:background="@android:color/darker_gray"/>

                -->

                <include layout="@layout/dashboard3_3"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dashboard_scroll_padding"/>

            </TableLayout>

        </LinearLayout>
    
    </RelativeLayout>

</ScrollView>

