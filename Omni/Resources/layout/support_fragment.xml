<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/support_margin"
    style="@style/activity_borders">

	<TextView
        android:text="@string/support_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/page_heading"
    />

	<ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

		<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

			<TextView
				android:id="@+id/support_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

			<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/page_subheading"
                android:text="@string/links"/>

			<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/page_link"
                android:text="@string/echook_forum"/>

			<TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/page_email"
                android:text="@string/omni_email"/>

		</LinearLayout>

	</ScrollView>

</LinearLayout>