<resources>

	<style name="AppTheme" parent="AppTheme.Base"></style>

	<style name="AppTheme.Base" parent="Theme.AppCompat.Light.DarkActionBar">
		<item name="colorPrimary">@color/colorPrimary</item>
		<item name="windowNoTitle">true</item>
		<item name="windowActionBar">false</item>
	</style>

	<style name="AppTheme.Splash" parent="Theme.AppCompat.Light.NoActionBar">
		<item name="android:windowBackground">@drawable/splash_screen</item>
		<item name="android:windowFullscreen">true</item>
		<item name="android:windowContentOverlay">@null</item>
		<item name="android:windowNoTitle">true</item>
		<item name="android:windowActionBar">false</item>
	</style>

  <style name="activity_borders" parent="AppTheme">
    <item name="android:layout_marginLeft">@dimen/activity_horizontal_margin</item>
    <item name="android:layout_marginRight">@dimen/activity_horizontal_margin</item>
    <item name="android:layout_marginTop">@dimen/activity_vertical_margin_narrow_top</item>
    <item name="android:layout_marginBottom">@dimen/activity_vertical_margin</item>
  </style>

  <style name="dashboard_values_base" parent="AppTheme">
    <item name="android:gravity">right</item>
    <item name="android:maxLines">1</item>
  </style>
  <style name="dashboard_values_xxxxl" parent="dashboard_values_base">
    <item name="android:textSize">160sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="dashboard_values_xxxl" parent="dashboard_values_base">
    <item name="android:textSize">120sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="dashboard_values_xxl" parent="dashboard_values_base">
    <item name="android:textSize">70sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="dashboard_values_xl" parent="dashboard_values_base">
    <item name="android:textSize">55sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="dashboard_values_l" parent="dashboard_values_base">
    <item name="android:textSize">40sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="dashboard_values_m" parent="dashboard_values_base">
    <item name="android:textSize">30sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="dashboard_values_s" parent="dashboard_values_base">
    <item name="android:textSize">20sp</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="dashboard_values_xs" parent="dashboard_values_base">
    <item name="android:textSize">12sp</item>
  </style>

  <style name="dashboard_units_base" parent="AppTheme">
    <item name="android:gravity">left</item>
    <item name="android:maxLines">1</item>
    <item name="android:layout_marginLeft">4dp</item>
  </style>
  <style name="dashboard_units_xxxxl" parent="dashboard_units_base">
    <item name="android:textSize">36sp</item>
  </style>
  <style name="dashboard_units_xxxl" parent="dashboard_units_base">
    <item name="android:textSize">24sp</item>
  </style>
  <style name="dashboard_units_xxl" parent="dashboard_units_base">
    <item name="android:textSize">18sp</item>
  </style>
  <style name="dashboard_units_xl" parent="dashboard_units_base">
    <item name="android:textSize">18sp</item>
  </style>
  <style name="dashboard_units_l" parent="dashboard_units_base">
    <item name="android:textSize">12sp</item>
  </style>
  <style name="dashboard_units_m" parent="dashboard_units_base">
    <item name="android:textSize">12sp</item>
  </style>
  <style name="dashboard_units_s" parent="dashboard_units_base">
    <item name="android:textSize">8sp</item>
  </style>
  <style name="dashboard_units_xs" parent="dashboard_units_base">
    <item name="android:textSize">8sp</item>
  </style>

  <style name="dashboard_tabular" parent="AppTheme">
    <item name="android:maxLines">1</item>
    <item name="android:textSize">11sp</item>
  </style>
	
	
  <style name="page_heading">
	<item name="android:textSize">24sp</item>
	<item name="android:textColor">@color/colorPrimary</item>
	<item name="android:layout_marginTop">10sp</item>
	<item name="android:layout_marginBottom">4sp</item>
  </style>

  <style name="page_subheading">
	<item name="android:textSize">20sp</item>
	<item name="android:textColor">@color/colorPrimary</item>
	<item name="android:layout_marginTop">10sp</item>
	<item name="android:layout_marginBottom">4sp</item>
  </style>

  <style name="page_link">
	<item name="android:layout_marginTop">4sp</item>
	<item name="android:layout_marginBottom">4sp</item>
	<item name="android:autoLink">web</item>
  </style>

  <style name="page_email">
	<item name="android:layout_marginTop">4sp</item>
	<item name="android:layout_marginBottom">4sp</item>
	<item name="android:autoLink">email</item>
  </style>

  <style name="page_text_emphasis">
	<item name="android:textStyle">bold|italic</item>
  </style>

</resources>

